<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="WearNormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="WearLaunchTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/wear_splash_icon</item>
        <item name="postSplashScreenTheme">@style/WearNormalTheme</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
